<Window x:Class="RevitMcpAddin.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RevitMcpAddin.ViewModels"
        mc:Ignorable="d"
        Title="RevitMCP — Claude · Revit Bridge"
        Width="650" Height="520"
        MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        Foreground="#CDD6F4"
        FontFamily="Segoe UI"
        FontSize="13"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- ── Colours ──────────────────────────────────────────────── -->
        <SolidColorBrush x:Key="Surface"        Color="#313244"/>
        <SolidColorBrush x:Key="Overlay"        Color="#45475A"/>
        <SolidColorBrush x:Key="Accent"         Color="#89B4FA"/>
        <SolidColorBrush x:Key="TextMuted"      Color="#6C7086"/>
        <SolidColorBrush x:Key="Green"          Color="#A6E3A1"/>
        <SolidColorBrush x:Key="Red"            Color="#F38BA8"/>

        <!-- ── Button style ─────────────────────────────────────────── -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"   Value="#89B4FA"/>
            <Setter Property="Foreground"   Value="#1E1E2E"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Padding"      Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#74C7EC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#F38BA8"/>
        </Style>

        <Style x:Key="GhostBtn"  TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#45475A"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
        </Style>

        <!-- ── Panel card ───────────────────────────────────────────── -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="#313244"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="12"/>
        </Style>

        <!-- ── Monospace log text ────────────────────────────────────── -->
        <Style x:Key="LogText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Courier New"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="#A6E3A1"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Status card -->
            <RowDefinition Height="*"/>     <!-- Log + Tools -->
            <RowDefinition Height="Auto"/>  <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ══════════ Header ══════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="🔌" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="RevitMCP" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
            <TextBlock Text=" · Claude ↔ Revit 2026" FontSize="13" VerticalAlignment="Bottom"
                       Foreground="{StaticResource TextMuted}" Margin="2,0,0,1"/>
        </StackPanel>

        <!-- ══════════ Status Card ═════════════════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: status info -->
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <!-- Status dot (Fill bound to brush string via converter) -->
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                 Fill="{Binding ServerStatusColor}"
                                 Margin="0,0,8,0"/>
                        <TextBlock Text="Server: " Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="{Binding ServerStatus}" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="URL: " Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="{Binding ServerUrl}"
                                   Foreground="{StaticResource Accent}"
                                   FontFamily="Cascadia Code, Consolas"
                                   Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding CopyUrlCommand}"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text=" (click to copy)" FontSize="10"
                                   Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Bottom" Margin="4,0,0,1"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: start / stop buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <Button Content="▶ Start"
                            Style="{StaticResource PrimaryBtn}"
                            Command="{Binding StartServerCommand}"
                            Margin="0,0,6,0"/>
                    <Button Content="■ Stop"
                            Style="{StaticResource DangerBtn}"
                            Command="{Binding StopServerCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════ Main area (Log + Tools) ═══════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Request Log ─────────────────────────────────────────── -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8">
                        <TextBlock Text="Request Log" FontWeight="SemiBold"
                                   Foreground="{StaticResource Accent}"
                                   DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <Button Content="Clear" Style="{StaticResource GhostBtn}"
                                Padding="8,3" FontSize="11"
                                Command="{Binding ClearLogCommand}"
                                DockPanel.Dock="Right"/>
                    </DockPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding RequestLog}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#45475A" BorderThickness="0,0,0,1"
                                            Padding="0,4">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Timestamp}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextMuted}"
                                                       FontFamily="Cascadia Code, Consolas"/>
                                            <TextBlock Text="{Binding Message}"
                                                       Style="{StaticResource LogText}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Divider -->
            <Rectangle Grid.Column="1" Fill="#45475A" Width="1" HorizontalAlignment="Center"/>

            <!-- Available Tools ─────────────────────────────────────── -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Tools"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Accent}"
                               Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding AvailableTools}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#45475A" CornerRadius="4"
                                        Padding="8,4" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding}"
                                               FontFamily="Cascadia Code, Consolas"
                                               FontSize="11"
                                               Foreground="#CBA6F7"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ══════════ Footer ══════════════════════════════════════════ -->
        <TextBlock Grid.Row="3" Margin="0,10,0,0"
                   Text="Configure Claude Code: add this server URL to .claude/mcp.json → revit → url"
                   FontSize="10"
                   Foreground="{StaticResource TextMuted}"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
